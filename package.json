{
  "name": "@blackbelt-technology/pi-dashboard-subagents",
  "version": "0.2.2",
  "description": "A lightweight subagent spawning and managing system for pi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackBeltTechnology/pi-dashboard-subagents.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "subagent",
    "agent"
  ],
  "type": "module",
  "main": "./extensions/index.ts",
  "exports": {
    ".": "./extensions/index.ts"
  },
  "files": [
    "extensions/",
    "agents/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "scripts": {
    "lint": "eslint extensions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@sinclair/typebox": "^0.34.49"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.75.5",
    "@earendil-works/pi-coding-agent": "^0.75.5",
    "@earendil-works/pi-tui": "^0.75.5",
    "@eslint/js": "^10.0.1",
    "@sinclair/typebox": "^0.34.49",
    "@types/node": "^25.8.0",
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.0.0"
  }
}
